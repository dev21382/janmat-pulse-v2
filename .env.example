# Optional: enables generative RAG answers AND LLM-based promise-taxonomy tagging
# (both use this same key). Without it: retrieval-only excerpts + keyword-based tagging.
# Get a free key at https://console.groq.com (no credit card required) and set it as a
# secret on your deployment platform — never commit it to git.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: enables real ML sentiment classification (cardiffnlp/twitter-roberta-base-
# sentiment-latest via HF's free Inference API) instead of VADER. Get a free token at
# https://huggingface.co/settings/tokens (no credit card required).
HF_API_TOKEN=
